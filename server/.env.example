# Port Configuration
PORT=5000

# Database Configuration (Local MongoDB or MongoDB Atlas URL)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/portfolioDB?retryWrites=true&w=majority

# Authentication Security (Change to a long random secret key)
JWT_SECRET=your_super_secret_key_12345

# ✉️ Email Notifications (SMTP Settings)
# To use Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Your Gmail address:
SMTP_USER=your_email@gmail.com

# Your secure 16-character Gmail "App Password":
SMTP_PASS=xxxx_xxxx_xxxx_xxxx

# Destination email where inquiries should be sent:
ADMIN_EMAIL=your_email@gmail.com
